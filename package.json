{
	"name": "cookie-review",
	"version": "0.0.0",
	"private": true,
	"description": "Biome pull request reviews on Cloudflare Workers",
	"scripts": {
		"build": "vite build",
		"check": "biome check .",
		"check:types": "tsc --noEmit",
		"deploy": "vite build && wrangler deploy",
		"dev": "vite dev",
		"test": "vitest run"
	},
	"license": "Apache-2.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.1.1",
			"onFail": "download"
		}
	},
	"type": "module",
	"dependencies": {
		"@cloudflare/sandbox": "0.12.8",
		"@flue/github": "2.0.3",
		"@flue/runtime": "2.0.3",
		"@octokit/rest": "22.0.1",
		"hono": "4.12.32",
		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@cloudflare/vite-plugin": "1.39.2",
		"@cloudflare/workers-types": "5.20260825.1",
		"@flue/cli": "2.0.3",
		"@flue/vite": "2.0.3",
		"@types/node": "22.19.0",
		"typescript": "7.0.2",
		"vite": "8.1.2",
		"vitest": "4.1.6",
		"wrangler": "4.126.0"
	}
}
